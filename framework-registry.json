{
  "$schema": "https://sigilcore.com/schemas/framework-registry.json",
  "version": "1.0.0",
  "registry_type": "agent_frameworks",
  "description": "Identifies agent frameworks that submit intents to a conforming SOF signer. Distinct from the registry of conforming signers (the authorization side).",
  "related_registries": {
    "conforming_signers": {
      "description": "Registry of SOF-conforming signer implementations: the systems that issue Intent Attestations.",
      "url": "https://github.com/Sigil-Core/sigil-open-framework/blob/main/conformance.md#registry-of-conforming-implementations"
    }
  },
  "validation": {
    "rule": "non-empty string, max 64 characters, lowercase alphanumeric and hyphens only",
    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
    "unknown_frameworks": "accepted with warning log"
  },
  "frameworks": [
    {
      "id": "agent-hooks",
      "name": "Generic TypeScript host",
      "category": "tool",
      "language": "typescript",
      "adapter": "checkIntent",
      "docs": "agent-hooks/overview"
    },
    {
      "id": "anthropic-sdk",
      "name": "Claude Code / Anthropic SDK",
      "category": "tool",
      "language": "typescript",
      "adapter": "checkAnthropicToolUse",
      "docs": "agent-hooks/claude-code"
    },
    {
      "id": "codex",
      "name": "OpenAI Codex",
      "category": "tool",
      "language": "typescript",
      "adapter": "checkIntent",
      "docs": "agent-hooks/codex"
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "category": "tool",
      "language": "typescript",
      "adapter": "checkIntent",
      "docs": "agent-hooks/openrouter"
    },
    {
      "id": "hermes",
      "name": "Hermes Agent",
      "category": "tool",
      "language": "typescript",
      "adapter": "checkIntent",
      "docs": "agent-hooks/hermes"
    },
    {
      "id": "mcp-proxy",
      "name": "Sigil MCP Proxy (Claude Desktop, Kimi)",
      "category": "tool",
      "language": "typescript",
      "adapter": "mcp-proxy",
      "docs": "mcp-proxy/overview"
    },
    {
      "id": "eliza",
      "name": "ELIZA",
      "category": "autonomous",
      "language": "typescript",
      "adapter": "checkElizaAction",
      "docs": "agent-hooks/eliza"
    },
    {
      "id": "langchain",
      "name": "LangChain",
      "category": "tool",
      "language": "typescript",
      "adapter": "wrapLangChainTool",
      "docs": "agent-hooks/langchain"
    },
    {
      "id": "openclaw",
      "name": "OpenClaw",
      "category": "autonomous",
      "language": "typescript",
      "adapter": "createOpenclawSigilHandler",
      "docs": "agent-hooks/overview"
    },
    {
      "id": "nemoclaw",
      "name": "NVIDIA NemoClaw",
      "category": "autonomous",
      "language": "typescript",
      "adapter": "createOpenclawSigilHandler",
      "docs": "agent-hooks/overview"
    },
    {
      "id": "ironclaw",
      "name": "IronClaw",
      "category": "autonomous",
      "language": "rust",
      "adapter": "sigil-agent-hooks-ironclaw",
      "docs": "agent-hooks/rust"
    },
    {
      "id": "agentpay",
      "name": "USD1 AgentPay (WLFI)",
      "category": "evm",
      "language": "typescript",
      "adapter": "checkIntent",
      "docs": "agent-hooks/agentpay"
    }
  ]
}
