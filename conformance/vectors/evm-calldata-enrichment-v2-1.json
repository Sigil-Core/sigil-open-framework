        "provenance": "shim",
        "metadata": {
          "evm": {
            "selector": "0xa9059cbb",
            "token_target": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
            "token_amount": "5000000"
          }
        }
      },
      "expected_decision": "ALLOWED",
      "expected_error_code": null
    }
  ]
}
