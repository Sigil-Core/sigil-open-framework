          "database": {
            "engine": "postgresql",
            "environment": "production",
            "operations": [
              "drop_table"
            ],
            "resources": [
              "app.users"
            ],
            "statement_count": 1,
            "credential_capabilities": [
              "select:app.*"
            ]
          }
        }
      },
      "expected_decision": "DENIED",
      "expected_error_code": "SIGIL_POLICY_VIOLATION_DATABASE_OPERATION_NOT_ALLOWED"
    }
  ]
