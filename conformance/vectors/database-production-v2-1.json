{
  "id": "PRODUCTION_DATABASE_DESTRUCTIVE_EFFECTS_BLOCKED",
  "policy": "version: 2.1.0\n\n## database\nactions: mcp.database.*\nprotected_environments: production\nallowed_operations: select\nallowed_resources: app.*\nroutine_catalog: catalog-v1\nrequire_read_only_for_select: true\ndeny_unreviewed_indirect_effects: true\nrequire_shim: true",
  "policy_hash": "computed-after-parse",
